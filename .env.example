# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is already in .gitignore.

# Supabase project URL (visible in: Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key — safe to expose in the browser
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# The service-role key must NEVER go here (client bundle).
# It is injected directly into Edge Function env vars via Supabase dashboard.
